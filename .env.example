# ============================================================
# ABD V2 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================


# ============================================================
# LLM Provider selection  (V2)
# ============================================================
# "ollama"  — use local Ollama server (recommended, no API key needed)
# "gemini"  — use Google Gemini API (requires GEMINI_API_KEY below)
LLM_PROVIDER=ollama


# ============================================================
# Ollama settings  (used when LLM_PROVIDER=ollama)
# ============================================================
# Base URL of the running Ollama server (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use — must be downloaded via: ollama pull <model>
# Recommended: qwen2.5-coder:7b  (coding-optimised, supports tool calling)
# Other options: llama3.2, mistral, codellama, deepseek-coder:6.7b
OLLAMA_MODEL=qwen2.5-coder:7b

# Stream responses token-by-token for faster terminal feedback
# Set to false to receive the complete response at once
OLLAMA_STREAM=true

# Request timeout in seconds (increase for large/slow models)
OLLAMA_TIMEOUT=120


# ============================================================
# Google Gemini API settings  (used when LLM_PROVIDER=gemini)
# ============================================================
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use — must support generateContent + function calling.
# Stable aliases (always resolve to latest available version):
#   gemini-flash-latest   — fast Flash model  (recommended)
#   gemini-pro-latest     — more capable Pro model
GEMINI_MODEL=gemini-flash-latest


# ============================================================
# Workspace & file settings
# ============================================================
# Workspace directory (relative to project root, or absolute path)
# ABD can only create/edit files inside this directory.
WORKSPACE_DIR=workspace

# Log file path
LOG_FILE=abd_actions.log


# ============================================================
# Agent settings
# ============================================================
# Maximum tool-call iterations per agent turn (prevents infinite loops)
MAX_TOOL_ITERATIONS=10

# PDF chunking: max characters per chunk sent to the LLM
PDF_CHUNK_SIZE=8000


# ============================================================
# Voice settings  (V2 Phase 2 — Basic Voice Conversation)
# ============================================================
# Master switch — set to false to disable all voice features.
# Users without a microphone or speakers can set this to false.
VOICE_ENABLED=true

# Default interaction mode when ABD starts.
#   "chat" — existing text-only CLI (default, preserves all V1/Phase 1 behaviour)
#   "talk" — Talk Mode (microphone → Speech-to-Text → agent → Text-to-Speech)
# You can always override this at launch with: python main.py --mode talk
VOICE_DEFAULT_MODE=chat

# --- Speech-to-Text (STT) ---
# Uses SpeechRecognition with Google Web Speech API (free, no API key needed)

# Seconds to wait for speech to begin before giving up (0 = wait forever)
VOICE_STT_TIMEOUT=5

# Maximum seconds of speech captured per utterance
VOICE_STT_PHRASE_LIMIT=15

# --- Text-to-Speech (TTS) ---
# Uses pyttsx3 with the system's built-in SAPI5 voices (Windows, offline)

# Speech rate in words per minute (Windows default: ~200, recommended: 160-190)
VOICE_TTS_RATE=175

# Volume: 0.0 (silent) to 1.0 (full volume)
VOICE_TTS_VOLUME=1.0

# Preferred voice gender: "male", "female", or "any"
# ABD will search installed system voices and pick the best match.
# Common Windows voices: "David" (male), "Zira" (female)
VOICE_TTS_VOICE_PREFERENCE=male

